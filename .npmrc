# The dependency tree has peer ranges npm's strict resolver rejects
# (vite 8 vs plugin peer ranges), which breaks plain `npm install` /
# `npm ci` in CI build images. This makes every npm run use the legacy
# resolver — the same job NPM_FLAGS=--legacy-peer-deps would do, but it
# travels with the repo instead of living in one host's settings.
legacy-peer-deps=true
